@model WorkAndEducationViewModel

@if(!string.IsNullOrEmpty(ViewData["TryCatchError"]?.ToString()))
{
    <div class="alert alert-danger">
        @ViewData["TryCatchError"]?.ToString()
    </div>
}
else
{
    <div id="organisationList" class="appSelectList app-select-list-theme">
        <div class="appSelectListHeader app-select-list-header-theme">
            <span>Work & Education History</span>
        </div>
        <div id="appSelectListContainer">
        @{ int i = 0; }
        @foreach(var organisation in Model.CompaniesAndSchools)
        {
            <div class="all-text appSelectListItem app-select-list-item-theme" onclick="selectOrganisation(@i)">@organisation.Name</div>
            i += 1;
        }
        <div class="appSelectListItemBuffer"></div>
        </div>
    </div>

    <div id="selectListContent">
        <div id="showOrgListMobileButton" class="aa-button aa-button-high-contrast" onclick="showOrganisationListMobile()"><img src="icons/backLight.svg" /> <span>Work & Education History</span></div>
    @foreach(var organisation in Model.CompaniesAndSchools)
    {
        <partial name="_SelectedOrganisation" model="@organisation" />
    }
    </div>
}