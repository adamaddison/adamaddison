@{
    var currentPage = ViewContext?.RouteData?.Values["action"]?.ToString() ?? string.Empty;
    if(currentPage.Contains("WorkAndEducation"))
    {
        currentPage = "Work & Education";
    }
}

<div id="menuBarContainer" class="menu-bar-container">
    <div class="menuItem firstMenuItem all-text">
        <a asp-controller="Page" asp-action="Home">
            <div class="menu-item-value">
                <span class="menuItemText">Home</span>
            </div>
        </a>
    </div>
    <div class="menuItem all-text">
        <a asp-controller="Page" asp-action="Portfolio">
            <div class="menu-item-value">
                <span class="menuItemText">Portfolio</span>
            </div>
        </a>
    </div>
    <div class="menuItem all-text">
        <a asp-controller="Page" asp-action="WorkAndEducation">
            <div class="menu-item-value">
                <span class="menuItemText">Work & Education</span>
            </div>
        </a>
    </div>
    <div class="menuItem all-text">
        <a asp-controller="Page" asp-action="Experience">
            <div class="menu-item-value">
                <span class="menuItemText">Experience</span>
            </div>
        </a>
    </div>
    <div class="menuItem all-text">
        <a asp-controller="Page" asp-action="About">
            <div class="menu-item-value">
                <span class="menuItemText">About</span>
            </div>
        </a>
    </div>
</div>

 <div id="menuBarMobilePopoutBackground"></div>
 <div id="menuBarMobilePopout" class="info-container">
        <a asp-controller="Page" asp-action="Home">
            <div class="menu-item-mobile firstMenuItemMobile">
                <span class="all-text">Home</span>
            </div>
        </a>
        <a asp-controller="Page" asp-action="Portfolio">
            <div class="menu-item-mobile">
                <span class="all-text">Portfolio</span>
            </div>
        </a>
        <a asp-controller="Page" asp-action="WorkAndEducation">
            <div class="menu-item-mobile">
                <span class="all-text">Work & Education</span>
            </div>
        </a>
        <a asp-controller="Page" asp-action="Experience">
            <div class="menu-item-mobile">
                <span class="all-text">Experience</span>
            </div>
        </a>
        <a asp-controller="Page" asp-action="About">
            <div class="menu-item-mobile">
                <span class="all-text">About</span>
            </div>
        </a>
</div>

<div id="menuBarContainerMobile" class="menu-bar-container-mobile-theme">
        <div id="menuBarMobileCurrentPageText" class="all-text">@currentPage</div>
        <div id="menuBarMobileShowPopoutButton" class="aa-button" onclick="togglePopoutMenu()">
            <div class="menuIconLine menu-icon-line-theme firstMenuLine"></div>
            <div class="menuIconLine menu-icon-line-theme"></div>
            <div class="menuIconLine menu-icon-line-theme"></div>
        </div>
</div>